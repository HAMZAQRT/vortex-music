import {
  Capacitor,
} from "@capacitor/core";

import {
  Preferences,
} from "@capacitor/preferences";

import {
  SplashScreen,
} from "@capacitor/splash-screen";

import {
  Filesystem,
  Directory,
} from "@capacitor/filesystem";

import {
  FileTransfer,
} from "@capacitor/file-transfer";

import {
  Network,
} from "@capacitor/network";

const TOKEN_KEY =
  "vortex.mobileToken";

const USER_KEY =
  "vortex.mobileUser";

const DOWNLOAD_KEY =
  "vortex.downloads";

async function getValue(key) {
  const { value } =
    await Preferences.get({
      key,
    });

  return value ?? null;
}

async function setValue(
  key,
  value,
) {
  await Preferences.set({
    key,
    value,
  });
}

async function removeValue(key) {
  await Preferences.remove({
    key,
  });
}

async function loadSession() {
  const [
    token,
    userJson,
  ] = await Promise.all([
    getValue(TOKEN_KEY),
    getValue(USER_KEY),
  ]);

  let user = null;

  if (userJson) {
    try {
      user =
        JSON.parse(userJson);
    } catch {
      user = null;
    }
  }

  return {
    token,
    user,
  };
}

async function saveSession(
  token,
  user,
) {
  await Promise.all([
    setValue(
      TOKEN_KEY,
      token,
    ),

    setValue(
      USER_KEY,
      JSON.stringify(
        user,
      ),
    ),
  ]);
}

async function clearSession() {
  await Promise.all([
    removeValue(TOKEN_KEY),
    removeValue(USER_KEY),
  ]);
}

async function loadDownloads() {
  const value =
    await getValue(
      DOWNLOAD_KEY,
    );

  if (!value) {
    return {};
  }

  try {
    return (
      JSON.parse(value) ??
      {}
    );
  } catch {
    return {};
  }
}

async function saveDownloads(
  downloads,
) {
  await setValue(
    DOWNLOAD_KEY,
    JSON.stringify(
      downloads,
    ),
  );
}

function safeName(value) {
  return value
    .replace(
      /[^a-zA-Z0-9_-]/g,
      "_",
    )
    .slice(0, 80);
}

async function downloadTrack(
  track,
  onProgress,
) {
  if (
    !track?.remoteId ||
    !track?.remoteUrl
  ) {
    throw new Error(
      "Track is not downloadable",
    );
  }

  const extension =
    track.remoteUrl
      .split("?")[0]
      .split(".")
      .pop() || "mp3";

  const filename =
    `${safeName(
      track.remoteId,
    )}.${safeName(
      extension,
    )}`;

  const directory =
    "vortex/audio";

  await Filesystem.mkdir({
    path: directory,
    directory:
      Directory.Data,
    recursive: true,
  }).catch(() => {});

  const relativePath =
    `${directory}/${filename}`;

  const file =
    await Filesystem.getUri({
      directory:
        Directory.Data,

      path:
        relativePath,
    });

  let progressHandle = null;

  if (onProgress) {
    progressHandle =
      await FileTransfer
        .addListener(
          "progress",
          (event) => {
            if (
              event.contentLength >
              0
            ) {
              const percent =
                Math.round(
                  (
                    event.bytes /
                    event.contentLength
                  ) *
                    100,
                );

              onProgress(
                Math.min(
                  100,
                  Math.max(
                    0,
                    percent,
                  ),
                ),
              );
            }
          },
        );
  }

  try {
    await FileTransfer
      .downloadFile({
        url:
          track.remoteUrl,

        path:
          file.uri,

        progress:
          true,
      });
  } finally {
    if (progressHandle) {
      await progressHandle
        .remove();
    }
  }

  const downloads =
    await loadDownloads();

  downloads[
    track.remoteId
  ] = {
    uri:
      file.uri,

    relativePath,

    title:
      track.title,

    artist:
      track.artist,

    cover:
      track.cover ?? null,

    duration:
      track.duration ?? 0,

    savedAt:
      new Date()
        .toISOString(),
  };

  await saveDownloads(
    downloads,
  );

  return downloads[
    track.remoteId
  ];
}

async function deleteDownload(
  remoteId,
) {
  const downloads =
    await loadDownloads();

  const item =
    downloads[remoteId];

  if (
    item?.relativePath
  ) {
    try {
      await Filesystem
        .deleteFile({
          path:
            item.relativePath,

          directory:
            Directory.Data,
        });
    } catch {
      // Continue with metadata cleanup.
    }
  }

  delete downloads[
    remoteId
  ];

  await saveDownloads(
    downloads,
  );

  return downloads;
}

function webFileSrc(
  uri,
) {
  return Capacitor.convertFileSrc(
    uri,
  );
}

async function networkStatus() {
  return Network.getStatus();
}

async function hideSplash() {
  try {
    await SplashScreen.hide();
  } catch {
    // Startup must continue.
  }
}

window.VortexNative = {
  loadSession,
  saveSession,
  clearSession,

  loadDownloads,
  downloadTrack,
  deleteDownload,

  networkStatus,
  webFileSrc,
  hideSplash,
};
